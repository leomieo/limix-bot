{
  "mcpServers": {
    "agent-desktop": {
      "command": "agent-desktop",
      "args": ["mcp"]
    },
    "windows-mcp": {
      "command": "uvx",
      "args": [
        "windows-mcp",
        "serve",
        "--exclude-tools",
        "PowerShell,Registry",
        "--control-policy",
        "balanced"
      ]
    }
  }
}
